{
  "name": "codecraft",
  "version": "1.0.0",
  "private": true,
  "description": "Static learning site with a framework-independent content catalogue.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build:content": "node scripts/build-catalog.cjs",
    "check:content": "node scripts/build-catalog.cjs --check",
    "pretest": "npm run check:content",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node scripts/test-browser.cjs",
    "lint": "eslint . --max-warnings 0",
    "check": "npm run lint && npm test && npm run test:browser"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "globals": "17.13.0"
  }
}
