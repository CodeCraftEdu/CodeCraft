{
  "name": "codecraft",
  "version": "1.0.0",
  "private": true,
  "description": "Static learning site with a framework-independent content catalogue.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "check:target": "node scripts/check-target.cjs",
    "build:content": "node scripts/build-catalog.cjs",
    "check:content": "node scripts/build-catalog.cjs --check",
    "pretest": "npm run check:content",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node scripts/test-browser.cjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier \"**/*.{js,mjs,cjs,json,css,yml,yaml}\" --write",
    "format:check": "prettier \"**/*.{js,mjs,cjs,json,css,yml,yaml}\" --check",
    "check": "npm run format:check && npm run lint && npm test && npm run test:browser"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "ajv": "8.20.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.10"
  }
}
