{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "orientation": {
      "type": "object",
      "properties": {
        "moduleId": {
          "type": "string",
          "minLength": 1
        },
        "blockId": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "prerequisiteSkills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "skillId": {
                "type": "string",
                "minLength": 1
              },
              "expectation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["skillId", "expectation"],
            "additionalProperties": false
          }
        }
      },
      "required": ["moduleId", "label"],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string"
        }
      },
      "required": ["id", "title", "path", "alt"],
      "additionalProperties": false
    },
    "teacherGuide": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "entryDiagnosis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preparation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "why": {
          "type": "string"
        },
        "discoverySpeech": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "example": {
          "$ref": "#/$defs/guideExample"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/guideQuestion"
          }
        },
        "accompaniedActivity": {
          "$ref": "#/$defs/target"
        },
        "independentActivity": {
          "$ref": "#/$defs/target"
        },
        "differentiation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commonErrors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/guideError"
          }
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "quickConductor": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/guideReference"
          }
        }
      },
      "required": ["objective"],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string"
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "code": {
          "type": "boolean"
        },
        "syntax": {
          "type": "string"
        }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "variant": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "html": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "feedback": {
          "type": "string"
        },
        "css": {
          "type": "string"
        },
        "tabTitle": {
          "type": "string"
        }
      },
      "required": ["label", "html", "code", "feedback"],
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "feedback": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["value", "feedback"],
      "additionalProperties": false
    },
    "demonstration": {
      "type": "object",
      "properties": {
        "type": {
          "enum": ["web-comparison", "flex-display", "flex-property"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "intro": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant"
          },
          "minItems": 1
        },
        "note": {
          "type": "string"
        },
        "codeLabel": {
          "type": "string"
        },
        "controlLabel": {
          "type": "string"
        },
        "previewLabel": {
          "type": "string"
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          },
          "minItems": 1
        },
        "property": {
          "type": "string"
        }
      },
      "required": ["type", "title", "intro"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "web-comparison"
              }
            }
          },
          "then": {
            "required": ["variants"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["flex-display", "flex-property"]
              }
            }
          },
          "then": {
            "required": ["cards", "options"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "flex-property"
              }
            }
          },
          "then": {
            "required": ["property"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "flex-display"
              }
            }
          },
          "then": {
            "required": ["controlLabel", "previewLabel"]
          }
        }
      ]
    },
    "block": {
      "type": "object",
      "properties": {
        "type": {
          "enum": ["callout", "lesson", "tasks", "details", "checklist", "reference", "resource"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "illustration": {
          "$ref": "#/$defs/illustration"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "intro": {
          "type": "string"
        },
        "downloads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "filename": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["label", "path", "filename"],
            "additionalProperties": false
          }
        },
        "valuesTitle": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "codeDiagram": {
          "$ref": "#/$defs/codeDiagram"
        },
        "code": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "actionSteps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actionStep"
          }
        },
        "moduleLink": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "moduleId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["text", "moduleId"],
          "additionalProperties": false
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "shortSteps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "activityLink": {
          "$ref": "#/$defs/orientation"
        },
        "visualScript": {
          "$ref": "#/$defs/visualScript"
        },
        "coordinateDiagram": {
          "$ref": "#/$defs/coordinateDiagram"
        },
        "demonstration": {
          "$ref": "#/$defs/demonstration"
        },
        "moduleId": {
          "type": "string",
          "minLength": 1
        },
        "blockId": {
          "type": "string",
          "minLength": 1
        },
        "tone": {
          "type": "string"
        },
        "presentation": {
          "type": "string"
        },
        "resourceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["type"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["lesson", "tasks", "checklist", "callout", "details"]
              }
            }
          },
          "then": {
            "required": ["id", "title"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["tasks", "checklist"]
              }
            }
          },
          "then": {
            "required": ["items"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tasks"
              }
            }
          },
          "then": {
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/item"
                    },
                    {
                      "type": "object",
                      "required": ["id"]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "details"
              }
            }
          },
          "then": {
            "required": ["blocks"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "callout"
              }
            }
          },
          "then": {
            "required": ["text"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "reference"
              }
            }
          },
          "then": {
            "required": ["moduleId", "blockId"]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "resource"
              }
            }
          },
          "then": {
            "required": ["resourceId"]
          }
        }
      ]
    },
    "module": {
      "type": "object",
      "properties": {
        "domainId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "skillIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "prerequisiteSkills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "skillId": {
                "type": "string",
                "minLength": 1
              },
              "expectation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["skillId", "expectation"],
            "additionalProperties": false
          }
        },
        "prerequisitesInContent": {
          "type": "boolean"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "masteryCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "teacherGuide": {
          "$ref": "#/$defs/teacherGuide"
        },
        "finalPathwayAction": {
          "type": "string"
        },
        "consolidation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/orientation"
          }
        },
        "bonusActivities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/orientation"
          }
        },
        "nextSteps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/orientation"
          }
        },
        "showTool": {
          "type": "boolean"
        },
        "presentation": {
          "type": "string"
        },
        "scratchProjectId": {
          "type": "string",
          "minLength": 1
        },
        "scratchProjectContinuation": {
          "type": "boolean"
        },
        "bonus": {
          "type": "string"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "stuck": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": ["title", "steps"],
          "additionalProperties": false
        },
        "tool": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["label", "url"],
          "additionalProperties": false
        }
      },
      "required": ["domainId", "title", "type", "objective", "skillIds", "blocks"],
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "moduleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "upcoming": {
          "type": "boolean"
        },
        "pause": {
          "type": "string"
        },
        "endMessage": {
          "type": "string"
        },
        "projectBlockId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["title", "moduleIds"],
      "additionalProperties": false
    },
    "pathway": {
      "type": "object",
      "properties": {
        "domainId": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "moduleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "nextStageLabel": {
          "type": "string"
        },
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        }
      },
      "required": ["domainId", "title", "theme", "objective", "moduleIds"],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "moduleId": {
          "type": "string",
          "minLength": 1
        },
        "blockId": {
          "type": "string",
          "minLength": 1
        },
        "itemId": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["moduleId"],
      "additionalProperties": false
    },
    "guideExample": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/$defs/target"
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["target", "comments"],
      "additionalProperties": false
    },
    "guideQuestion": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["question", "answer"],
      "additionalProperties": false
    },
    "guideError": {
      "type": "object",
      "properties": {
        "symptom": {
          "type": "string",
          "minLength": 1
        },
        "helps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["symptom", "helps"],
      "additionalProperties": false
    },
    "guideReference": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["title", "url"],
      "additionalProperties": false
    },
    "illustration": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        }
      },
      "required": ["src", "alt"],
      "additionalProperties": false
    },
    "codePart": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "function",
            "string",
            "keyword",
            "number",
            "comment",
            "operator",
            "tag",
            "attribute"
          ]
        }
      },
      "required": ["text"],
      "additionalProperties": false
    },
    "codeDiagram": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "codeParts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/codePart"
          }
        },
        "output": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": ["filename", "codeParts", "output"],
      "additionalProperties": false
    },
    "actionStep": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "paragraphIndex": {
          "type": "integer",
          "minimum": 0
        },
        "showCode": {
          "type": "boolean"
        },
        "output": {
          "type": "string"
        }
      },
      "required": ["title", "paragraphIndex"],
      "additionalProperties": false
    },
    "coordinateDiagram": {
      "type": "object",
      "properties": {
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "center": {
          "type": "string",
          "minLength": 1
        },
        "up": {
          "type": "string",
          "minLength": 1
        },
        "down": {
          "type": "string",
          "minLength": 1
        },
        "left": {
          "type": "string",
          "minLength": 1
        },
        "right": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      },
      "required": ["caption", "center", "up", "down", "left", "right"],
      "additionalProperties": false
    },
    "scratchPart": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "flag": {
              "const": true
            }
          },
          "required": ["flag"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "string"
            }
          },
          "required": ["value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "reporter": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "enum": ["motion", "variables", "sensing", "operators"]
            }
          },
          "required": ["reporter", "category"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "choice": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["choice"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/scratchPart"
              }
            },
            "operator": {
              "type": "boolean"
            }
          },
          "required": ["condition"],
          "additionalProperties": false
        }
      ]
    },
    "scratchBlock": {
      "type": "object",
      "properties": {
        "category": {
          "enum": ["events", "motion", "looks", "control", "sensing", "variables", "custom"]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scratchPart"
          }
        },
        "explanation": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scratchBlock"
          }
        }
      },
      "required": ["category", "label", "parts"],
      "additionalProperties": false
    },
    "scratchStack": {
      "type": "object",
      "properties": {
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scratchBlock"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "required": ["caption", "blocks"],
      "additionalProperties": false
    },
    "visualScript": {
      "oneOf": [
        {
          "$ref": "#/$defs/scratchStack"
        },
        {
          "type": "object",
          "properties": {
            "caption": {
              "type": "string",
              "minLength": 1
            },
            "stacks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/scratchStack"
              }
            },
            "note": {
              "type": "string"
            }
          },
          "required": ["caption", "stacks"],
          "additionalProperties": false
        }
      ]
    }
  }
}
