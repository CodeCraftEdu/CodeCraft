{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "propertyNames": {
    "minLength": 1
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1
      },
      "starterUrl": {
        "type": ["string", "null"]
      },
      "demoUrl": {
        "type": ["string", "null"]
      },
      "studentInstructions": {
        "type": "string"
      },
      "teacherInstructions": {
        "type": "string"
      }
    },
    "required": ["title"],
    "additionalProperties": false
  }
}
