{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "say": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "say": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": ["title", "items"],
              "additionalProperties": false
            }
          }
        },
        "required": ["time", "title"],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": ["items"]
          },
          {
            "required": ["groups"]
          }
        ]
      }
    },
    "principlesTitle": {
      "type": "string",
      "minLength": 1
    },
    "principles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "connection": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "returnPrompt": {
          "type": "string",
          "minLength": 1
        },
        "chatExamples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["title", "items", "returnPrompt", "chatExamples"],
      "additionalProperties": false
    },
    "notes": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["title", "description", "states"],
      "additionalProperties": false
    },
    "studentLinkLabel": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "title",
    "subtitle",
    "schedule",
    "principlesTitle",
    "principles",
    "connection",
    "notes",
    "studentLinkLabel"
  ],
  "additionalProperties": false
}
