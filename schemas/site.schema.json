      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "codepenLabel": {
      "type": "string",
      "minLength": 1
    },
    "codepenUrl": {
      "type": "string",
      "minLength": 1
    },
    "homeLabel": {
      "type": "string",
      "minLength": 1
    },
    "homeIntro": {
      "type": "string",
      "minLength": 1
    },
    "homeChoiceLabel": {
      "type": "string",
      "minLength": 1
